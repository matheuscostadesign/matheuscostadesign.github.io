<div class="newsletter-box">
  <div class="newsletter-header">
    <div class="newsletter-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
        <polyline points="22,6 12,13 2,6"></polyline>
      </svg>
    </div>
    <div class="newsletter-text">
      <h4 class="newsletter-title">Receba novos artigos e insights no seu e-mail</h4>
      <p class="newsletter-desc">Sem spam. Apenas conteúdos selecionados sobre UX/UI, desenvolvimento front-end e SEO.</p>
    </div>
  </div>
  <form class="newsletter-form js-newsletter-form">
    <input
      type="email"
      required
      placeholder="Digite seu melhor e-mail..."
      class="newsletter-input"
      aria-label="Endereço de e-mail"
    />
    <button type="submit" class="newsletter-btn">
      <span>Inscrever-se</span>
    </button>
  </form>
</div>

<style>
  .newsletter-box {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 36px 40px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: 24px;
    margin: 48px 0;
  }

  .newsletter-header {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .newsletter-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-main);
    flex-shrink: 0;
  }

  .newsletter-text {
    flex: 1;
  }

  .newsletter-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: normal;
    color: var(--color-text-main);
    margin: 0 0 6px;
    line-height: 1.3;
  }

  .newsletter-desc {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .newsletter-form {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
  }

  .newsletter-input {
    flex: 1;
    width: 100%;
    height: 56px;
    padding: 0 24px;
    border-radius: 14px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-main);
    font-family: var(--font-body);
    font-size: 16px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .newsletter-input:focus {
    border-color: var(--color-border-hover);
    box-shadow: 0 0 0 4px rgba(244, 240, 231, 0.06);
  }

  .newsletter-input::placeholder {
    color: var(--color-text-dimmed);
  }

  .newsletter-btn {
    height: 56px;
    padding: 0 32px;
    border-radius: 14px;
    background: var(--color-text-main);
    color: var(--color-bg-main);
    border: none;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .newsletter-btn:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  @media (max-width: 640px) {
    .newsletter-box {
      padding: 24px 20px;
      gap: 20px;
    }

    .newsletter-header {
      flex-direction: column;
      gap: 16px;
    }

    .newsletter-form {
      flex-direction: column;
      gap: 12px;
    }

    .newsletter-input {
      height: 52px;
      font-size: 15px;
    }

    .newsletter-btn {
      width: 100%;
      height: 52px;
      font-size: 15px;
    }
  }
</style>

<script>
  function setupNewsletterForm() {
    const forms = document.querySelectorAll(".js-newsletter-form");
    forms.forEach((form) => {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const input = form.querySelector("input") as HTMLInputElement;
        const btn = form.querySelector("button");
        if (input && btn) {
          const email = input.value.trim();
          if (email) {
            const subscribers = JSON.parse(
              localStorage.getItem("newsletter_subscribers") || "[]"
            );
            subscribers.push({
              email,
              subscribedAt: new Date().toISOString(),
            });
            localStorage.setItem(
              "newsletter_subscribers",
              JSON.stringify(subscribers, null, 2)
            );
          }

          btn.innerHTML = "<span>Inscrito com sucesso!</span>";
          input.value = "";
          setTimeout(() => {
            btn.innerHTML = "<span>Inscrever-se</span>";
          }, 3000);
        }
      });
    });
  }

  setupNewsletterForm();
  document.addEventListener("astro:page-load", setupNewsletterForm);
</script>
