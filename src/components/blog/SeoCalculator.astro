---

---

<div class="calculator-card" id="estimador-projeto">
  <div class="calculator-header">
    <div class="calc-badge">
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
      <span>Simulador de Orçamento</span>
    </div>
    <h3 class="calculator-title">Monte sua Estimativa em Segundos</h3>
    <p class="calculator-desc">
      Escolha o escopo ideal e receba um orçamento prévio instantâneo.
    </p>
  </div>

  <div class="calculator-body">
    <div class="estimator-section">
      <div class="step-header">
        <span class="step-num">1</span>
        <span class="step-label">Tipo de Projeto</span>
      </div>
      <div class="options-grid" id="type-options">
        <button
          type="button"
          class="option-card active"
          data-type="lp"
          data-base-min="1200"
          data-base-max="2200"
          data-days-min="3"
          data-days-max="5"
          data-name="Landing Page"
        >
          <div class="option-header-row">
            <span class="option-name">Landing Page</span>
            <div class="radio-indicator"></div>
          </div>
          <span class="option-sub">Foco total em conversão de leads</span>
        </button>
        <button
          type="button"
          class="option-card"
          data-type="site"
          data-base-min="2800"
          data-base-max="4800"
          data-days-min="7"
          data-days-max="12"
          data-name="Site Institucional"
        >
          <div class="option-header-row">
            <span class="option-name">Site Institucional</span>
            <div class="radio-indicator"></div>
          </div>
          <span class="option-sub">Estrutura completa e autoridade</span>
        </button>
        <button
          type="button"
          class="option-card"
          data-type="uiux"
          data-base-min="3000"
          data-base-max="5500"
          data-days-min="10"
          data-days-max="18"
          data-name="Design UI/UX"
        >
          <div class="option-header-row">
            <span class="option-name">Design UI/UX</span>
            <div class="radio-indicator"></div>
          </div>
          <span class="option-sub">Prototipagem e interface exclusiva</span>
        </button>
      </div>
    </div>

    <div class="estimator-section">
      <div class="step-header">
        <span class="step-num">2</span>
        <span class="step-label">Adicionais Opcionais</span>
      </div>
      <div class="extras-grid" id="extra-options">
        <button
          type="button"
          class="extra-pill"
          data-extra="i18n"
          data-price-min="500"
          data-price-max="1000"
          data-days="2"
          data-name="Múltiplos Idiomas (i18n)"
        >
          <span class="pill-check"></span>
          <span>Múltiplos Idiomas (i18n)</span>
        </button>
        <button
          type="button"
          class="extra-pill"
          data-extra="cms"
          data-price-min="800"
          data-price-max="1600"
          data-days="3"
          data-name="Sistema de Blog / CMS"
        >
          <span class="pill-check"></span>
          <span>Sistema de Blog / CMS</span>
        </button>
        <button
          type="button"
          class="extra-pill"
          data-extra="support"
          data-price-min="400"
          data-price-max="800"
          data-days="0"
          data-name="Manutenção & Suporte Mensal"
        >
          <span class="pill-check"></span>
          <span>Manutenção & Suporte Mensal</span>
        </button>
      </div>
    </div>

    <div class="proposal-summary-card">
      <div class="summary-details">
        <div class="summary-item">
          <span class="summary-label">Prazo Estimado</span>
          <span class="summary-val" id="result-days">3 a 5 dias úteis</span>
        </div>
        <div class="summary-divider"></div>
        <div class="summary-item highlight">
          <span class="summary-label">Investimento Estimado</span>
          <span class="summary-val price-val" id="result-price">R$ 1.200 – R$ 2.200</span>
        </div>
      </div>

      <div class="cta-action-area">
        <div class="online-status">
          <span class="status-pulse"></span>
          <span>Orçamento sem compromisso no WhatsApp</span>
        </div>
        <a
          id="estimator-wa-btn"
          href="https://wa.me/5517991005132"
          target="_blank"
          rel="noopener noreferrer"
          class="calc-cta-btn"
        >
          <span>Enviar Simulação pelo WhatsApp</span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="cta-arrow-icon"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .calculator-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 24px;
    padding: 32px;
    margin: 44px 0;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.2);
    position: relative;
    overflow: hidden;
  }

  .calculator-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--color-text-main), transparent);
    opacity: 0.6;
  }

  .calculator-header {
    margin-bottom: 28px;
  }

  .calc-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px;
    border-radius: 9999px;
    background: rgba(244, 240, 231, 0.06);
    border: 1px solid var(--color-border-subtle);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-main);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 12px;
  }

  .calculator-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.5vw, 28px);
    font-weight: normal;
    color: var(--color-text-main);
    margin: 0 0 6px;
    line-height: 1.2;
  }

  .calculator-desc {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .calculator-body {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .estimator-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .step-header {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-text-main);
    color: var(--color-bg-main);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
  }

  .step-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-main);
  }

  .options-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .option-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    text-align: left;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: 16px;
    padding: 16px;
    cursor: pointer;
    transition: all 0.25s ease;
    width: 100%;
    position: relative;
  }

  .option-card:hover {
    border-color: var(--color-border-hover);
    background: var(--color-bg-elevated);
    transform: translateY(-2px);
  }

  .option-card.active {
    background: var(--color-bg-elevated);
    border-color: var(--color-text-main);
    box-shadow: 0 0 16px rgba(255, 255, 255, 0.06);
  }

  .option-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 4px;
  }

  .option-name {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .radio-indicator {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1.5px solid var(--color-border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .option-card.active .radio-indicator {
    border-color: var(--color-text-main);
  }

  .option-card.active .radio-indicator::after {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-text-main);
  }

  .option-sub {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-text-dimmed);
    line-height: 1.35;
  }

  .extras-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .extra-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-radius: 9999px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .extra-pill:hover {
    border-color: var(--color-border-hover);
    color: var(--color-text-main);
  }

  .extra-pill.active {
    background: var(--color-bg-elevated);
    border-color: var(--color-text-main);
    color: var(--color-text-main);
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.05);
  }

  .pill-check {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1.5px solid var(--color-border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .extra-pill.active .pill-check {
    background: var(--color-text-main);
    border-color: var(--color-text-main);
  }

  .extra-pill.active .pill-check::after {
    content: "";
    width: 4px;
    height: 7px;
    border: solid var(--color-bg-main);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    margin-bottom: 1px;
  }

  .proposal-summary-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-hover);
    border-radius: 20px;
    padding: 24px;
    margin-top: 8px;
  }

  .summary-details {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .summary-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .summary-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border-subtle);
  }

  .summary-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-dimmed);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .summary-val {
    font-family: var(--font-display);
    font-size: clamp(16px, 2vw, 20px);
    font-weight: 600;
    color: var(--color-text-main);
  }

  .summary-val.price-val {
    font-size: clamp(20px, 2.5vw, 26px);
  }

  .cta-action-area {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
  }

  .online-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .status-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    animation: pulseDot 2s infinite;
  }

  @keyframes pulseDot {
    0% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(34, 197, 94, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  .calc-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    padding: 16px 28px;
    border-radius: 9999px;
    background: var(--color-text-main);
    color: var(--color-bg-main);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 6px 20px rgba(255, 255, 255, 0.12);
  }

  .calc-cta-btn:hover {
    transform: translateY(-3px) scale(1.01);
    box-shadow: 0 10px 30px rgba(255, 255, 255, 0.25);
  }

  .cta-arrow-icon {
    transition: transform 0.2s ease;
  }

  .calc-cta-btn:hover .cta-arrow-icon {
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .calculator-card {
      padding: 20px;
    }

    .options-grid {
      grid-template-columns: 1fr;
    }

    .summary-details {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .summary-divider {
      width: 100%;
      height: 1px;
    }
  }
</style>

<script>
  function setupProjectEstimator() {
    const typeCards = document.querySelectorAll("#type-options .option-card");
    const extraPills = document.querySelectorAll("#extra-options .extra-pill");

    const resultDays = document.querySelector("#result-days") as HTMLElement;
    const resultPrice = document.querySelector("#result-price") as HTMLElement;
    const waBtn = document.querySelector(
      "#estimator-wa-btn",
    ) as HTMLAnchorElement;

    if (!typeCards.length || !resultDays || !resultPrice || !waBtn) return;

    function formatBRL(val: number) {
      const formatted = val.toLocaleString("pt-BR", {
        maximumFractionDigits: 0,
      });
      return `R$ ${formatted}`;
    }

    function calculate() {
      let activeTypeCard = document.querySelector(
        "#type-options .option-card.active",
      ) as HTMLElement;
      let activeExtras = document.querySelectorAll(
        "#extra-options .extra-pill.active",
      );

      if (!activeTypeCard) activeTypeCard = typeCards[0] as HTMLElement;

      const baseMin = parseFloat(activeTypeCard.dataset.baseMin || "0");
      const baseMax = parseFloat(activeTypeCard.dataset.baseMax || "0");
      const daysMin = parseInt(activeTypeCard.dataset.daysMin || "0", 10);
      const daysMax = parseInt(activeTypeCard.dataset.daysMax || "0", 10);
      const typeName = activeTypeCard.dataset.name || "";

      let extraMinSum = 0;
      let extraMaxSum = 0;
      let extraDaysSum = 0;
      const extraNames: string[] = [];

      activeExtras.forEach((card) => {
        const el = card as HTMLElement;
        extraMinSum += parseFloat(el.dataset.priceMin || "0");
        extraMaxSum += parseFloat(el.dataset.priceMax || "0");
        extraDaysSum += parseInt(el.dataset.days || "0", 10);
        if (el.dataset.name) extraNames.push(el.dataset.name);
      });

      const totalMin = baseMin + extraMinSum;
      const totalMax = baseMax + extraMaxSum;
      const totalDaysMin = daysMin + extraDaysSum;
      const totalDaysMax = daysMax + extraDaysSum;

      resultDays.textContent = `${totalDaysMin} a ${totalDaysMax} dias úteis`;
      resultPrice.textContent = `${formatBRL(totalMin)} – ${formatBRL(totalMax)}`;

      const extrasText = extraNames.length
        ? extraNames.join(", ")
        : "Sem adicionais";

      const lines = [
        "Olá Matheus! Fiz uma simulação no site:",
        "",
        `📌 Projeto: ${typeName}`,
        `✨ Adicionais: ${extrasText}`,
        "",
        `⏱️ Prazo: ${totalDaysMin} a ${totalDaysMax} dias úteis`,
        `💰 Estimativa: ${formatBRL(totalMin)} a ${formatBRL(totalMax)}`,
        "",
        "Gostaria de um orçamento!",
      ];

      const message = lines.join("\n");
      waBtn.href = `https://wa.me/5517991005132?text=${encodeURIComponent(message)}`;
    }

    typeCards.forEach((card) => {
      card.addEventListener("click", () => {
        typeCards.forEach((c) => c.classList.remove("active"));
        card.classList.add("active");
        calculate();
      });
    });

    extraPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        pill.classList.toggle("active");
        calculate();
      });
    });

    calculate();
  }

  setupProjectEstimator();
  document.addEventListener("astro:page-load", setupProjectEstimator);
</script>

