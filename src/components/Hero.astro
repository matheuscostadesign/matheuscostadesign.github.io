---
import { Image } from "astro:assets";

import projeto01 from "../assets/carousel/projeto01.webp";
import projeto02 from "../assets/carousel/projeto02.webp";
import projeto03 from "../assets/carousel/projeto03.webp";
import projeto04 from "../assets/carousel/projeto04.webp";
import projeto05 from "../assets/carousel/projeto05.webp";
import projeto06 from "../assets/carousel/projeto06.webp";
import projeto07 from "../assets/carousel/projeto07.webp";
import projeto08 from "../assets/carousel/projeto08.webp";
import projeto09 from "../assets/carousel/projeto09.webp";
import projeto10 from "../assets/carousel/projeto10.webp";
import projeto11 from "../assets/carousel/projeto11.webp";
import projeto12 from "../assets/carousel/projeto12.webp";
import projeto13 from "../assets/carousel/projeto13.webp";
import projeto14 from "../assets/carousel/projeto14.webp";

import portraitImg from "../assets/hero/portrait.webp";
import linkedinIcon from "../assets/icons/linkedin.svg";
import instagramIcon from "../assets/icons/instagram.svg";
import whatsappIcon from "../assets/icons/whatsapp.svg";

import DriftWall from "./DriftWall.astro";
import HeroCarousel from "./HeroCarousel.astro";
import ParticlesBg from "./Backgrounds/ParticlesBg.astro";

const driftWallItems = [
  { image: projeto01.src, title: "Projeto 01" },
  { image: projeto02.src, title: "Projeto 02" },
  { image: projeto03.src, title: "Projeto 03" },
  { image: projeto04.src, title: "Projeto 04" },
  { image: projeto05.src, title: "Projeto 05" },
  { image: projeto06.src, title: "Projeto 06" },
  { image: projeto07.src, title: "Projeto 07" },
  { image: projeto08.src, title: "Projeto 08" },
  { image: projeto09.src, title: "Projeto 09" },
  { image: projeto10.src, title: "Projeto 10" },
  { image: projeto11.src, title: "Projeto 11" },
  { image: projeto12.src, title: "Projeto 12" },
  { image: projeto13.src, title: "Projeto 13" },
  { image: projeto14.src, title: "Projeto 14" },
];
---

<section data-screen-label="Hero" class="hero">
  <ParticlesBg />
  <div class="hero-content">
    <div class="hero-stage--desktop">
      <DriftWall
        items={driftWallItems}
        columns={5}
        tileWidth={360}
        tileHeight={225}
        gap={24}
        radius={16}
        tilt={16}
        turn={-14}
        perspective={1200}
        depth={120}
        speed={42}
        dim={0.55}
        overlayColor="rgba(5, 5, 5, 0.2)"
      />
    </div>

    <div class="hero-stage--mobile">
      <HeroCarousel />
    </div>

    <div class="hero-fade hero-fade--left"></div>
    <div class="hero-fade hero-fade--right"></div>
    <div class="hero-vignette-center"></div>
    <div class="hero-halo"></div>

    <div class="hero-portrait">
      <Image
        src={portraitImg}
        alt="Matheus Costa"
        class="hero-portrait-img"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="hero-fade-bottom"></div>

    <div class="hero-bottom">
      <div class="hero-main">
        <h1 class="hero-title">
          Frontend <span class="italic">D</span>eveloper
        </h1>
        <p class="hero-bio">
          Levo ideias do Figma ao código, criando interfaces modernas,
          intuitivas e funcionais.
        </p>
        <div class="hero-footer-bar">
          <a
            href="https://api.whatsapp.com/send?phone=5517991005132&text=Ol%C3%A1%2C%20Matheus!%20Vi%20seu%20site%20e%20gostaria%20de%20conversar%20sobre%20um%20projeto."
            target="_blank"
            rel="noopener noreferrer"
            class="hero-cta"
          >
            <span class="hero-arrow">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="4" y1="12" x2="18.5" y2="12"></line>
                <polyline points="12.5 6 19 12 12.5 18"></polyline>
              </svg>
            </span>
            <span class="hero-text">Vamos conversar</span>
          </a>
          <div class="hero-socials">
            <a
              href="https://linkedin.com/in/mattheuscosta"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="hero-social-btn"
            >
              <Image
                src={linkedinIcon}
                alt="LinkedIn"
                class="hero-social-icon"
              />
            </a>
            <a
              href="https://www.instagram.com/matheuscosta.design/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="hero-social-btn"
            >
              <Image
                src={instagramIcon}
                alt="Instagram"
                class="hero-social-icon"
              />
            </a>
            <a
              href="https://api.whatsapp.com/send?phone=5517991005132&text=Ol%C3%A1%2C%20Matheus!%20Vi%20seu%20site%20e%20gostaria%20de%20conversar."
              target="_blank"
              rel="noopener noreferrer"
              aria-label="WhatsApp"
              class="hero-social-btn"
            >
              <Image
                src={whatsappIcon}
                alt="WhatsApp"
                class="hero-social-icon"
              />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: radial-gradient(
      120% 90% at 50% 0%,
      var(--color-bg-surface) 0%,
      var(--color-bg-main) 60%
    );
  }

  .hero-icon {
    position: absolute;
    left: 50%;
    top: 130px;
    transform: translateX(-50%);
    width: min(64vh, 54vw);
    z-index: 0;
    opacity: 0.9;
    pointer-events: none;
  }

  .hero-icon svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-content {
    position: relative;
    width: 100%;
    min-height: 100vh;
    flex: 1;
  }

  .hero-stage--desktop {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 4;
    overflow: hidden;
    user-select: none;
    touch-action: pan-y;
  }

  .hero-stage--mobile {
    display: none;
  }

  .hero-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(90px, 14vw, 240px);
    z-index: 3;
    pointer-events: none;
  }

  .hero-fade--left {
    left: 0;
    background: linear-gradient(to right, var(--color-bg-main), transparent);
  }

  .hero-fade--right {
    right: 0;
    background: linear-gradient(to left, var(--color-bg-main), transparent);
  }

  .hero-vignette-center {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      58% 70% at 50% 46%,
      rgba(5, 5, 5, 0.1) 0%,
      rgba(5, 5, 5, 0) 62%
    );
  }

  .hero-halo {
    position: absolute;
    left: 50%;
    right: auto;
    top: 48%;
    transform: translate(-50%, -50%);
    width: clamp(600px, 70vw, 1200px);
    height: clamp(600px, 90vh, 1200px);
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      50% 54% at 50% 46%,
      rgba(5, 5, 5, 0.25) 0%,
      rgba(5, 5, 5, 0.12) 40%,
      rgba(0, 0, 0, 0) 80%
    );
    filter: blur(12px);
  }

  :global(html[data-theme="light"]) .hero {
    background: radial-gradient(120% 90% at 50% 0%, #ffffff 0%, #f3f0ea 65%);
  }

  :global(html[data-theme="light"]) .hero-vignette-center {
    background: radial-gradient(
      58% 70% at 50% 46%,
      rgba(243, 240, 234, 0.08) 0%,
      transparent 62%
    );
  }

  :global(html[data-theme="light"]) .hero-halo {
    background: radial-gradient(
      50% 54% at 50% 46%,
      rgba(255, 255, 255, 0.25) 0%,
      rgba(255, 255, 255, 0.1) 40%,
      transparent 80%
    );
  }

  .hero-portrait {
    position: absolute;
    left: 50%;
    right: auto;
    top: clamp(80px, 9vh, 120px);
    bottom: auto;
    transform: translateX(-50%);
    width: clamp(250px, 31vw, 470px);
    height: clamp(340px, 56vh, 580px);
    z-index: 5;
    pointer-events: none;
  }

  .hero-portrait-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center top;
    display: block;
    mask-image: linear-gradient(
      to bottom,
      #000 50%,
      rgba(0, 0, 0, 0.9) 90%,
      transparent 98%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 50%,
      rgba(0, 0, 0, 0.9) 90%,
      transparent 98%
    );
  }

  .hero-portrait-vignette {
    display: none;
  }

  .hero-fade-bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: clamp(240px, 35vh, 420px);
    z-index: 6;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      var(--color-bg-main) 85%
    );
  }

  .hero-bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 64px) clamp(28px, 4vw, 48px);
    pointer-events: none;
    text-align: center;
  }

  .hero-main {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    pointer-events: auto;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: clamp(16px, 2vw, 22px);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-main);
    margin: 4px auto 20px;
    text-align: center;
    opacity: 0.95;
  }

  .hero-title {
    margin: 0 auto 16px;
    font-family: var(--font-display);
    font-weight: normal;
    font-size: var(--text-h1);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-text-main);
    text-align: center;
    padding-top: 64px;
  }

  .hero-bio {
    margin: 0 auto 28px;
    max-width: 720px;
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-text-muted);
    text-align: center;
  }

  .hero-footer-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(24px, 4vw, 36px);
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: var(--color-text-main);
    color: var(--color-bg-main);
    border-radius: 999px;
    padding: 8px 24px 8px 8px;
    font-size: 15px;
    font-weight: 600;
    border: 1px solid var(--color-text-main);
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s,
      box-shadow 0.3s;
  }

  .hero-cta:hover {
    background: var(--color-bg-elevated);
    color: var(--color-text-main);
    border-color: var(--color-border-hover);
    box-shadow: 0 0 24px rgba(0, 0, 0, 0.15);
  }

  .hero-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-bg-main);
    color: var(--color-text-main);
    flex-shrink: 0;
    transition:
      background 0.3s,
      color 0.3s,
      transform 0.45s cubic-bezier(0.45, 0, 0.2, 1);
  }

  .hero-text {
    transition: transform 0.45s cubic-bezier(0.45, 0, 0.2, 1);
  }

  .hero-cta:hover .hero-arrow {
    background: var(--color-text-main);
    color: var(--color-bg-main);
    transform: translateX(var(--arrShift, 130px)) rotate(90deg);
  }

  .hero-cta:hover .hero-text {
    transform: translateX(var(--txtShift, -54px));
  }

  .hero-socials {
    display: flex;
    gap: 14px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--color-border-subtle);
    background: var(--color-bg-card);
    transition:
      border-color 0.2s,
      background 0.2s;
  }

  .hero-social-btn:hover {
    border-color: var(--color-border-hover);
    background: var(--color-bg-elevated);
  }

  .hero-social-icon {
    display: block;
    width: 20px;
    height: 20px;
  }

  :global(html[data-theme="light"]) .hero-social-icon {
    filter: invert(1);
  }

  @media (max-width: 1440px) and (min-width: 761px) {
    .hero-portrait {
      top: clamp(90px, 10vh, 120px);
      width: clamp(290px, 33vw, 460px);
      height: clamp(380px, 58vh, 520px);
    }
    .hero-title {
      font-size: clamp(40px, 4.6vw, 68px);
      margin-bottom: 10px;
    }
    .hero-bio {
      font-size: 15px;
      margin-bottom: 18px;
      max-width: 620px;
    }
    .hero-bottom {
      padding-bottom: clamp(44px, 6.5vh, 76px);
    }
  }

  @media (max-height: 850px) and (min-width: 761px) {
    .hero-portrait {
      top: clamp(85px, 9.5vh, 112px);
      width: clamp(290px, 33vw, 460px);
      height: clamp(370px, 57vh, 510px);
    }
    .hero-title {
      font-size: clamp(38px, 4.4vw, 60px);
      margin-bottom: 8px;
    }
    .hero-bio {
      font-size: 14.5px;
      margin-bottom: 16px;
    }
    .hero-bottom {
      padding-bottom: clamp(40px, 6vh, 70px);
    }
  }

  @media (min-width: 761px) and (max-width: 1100px) {
    .hero-title {
      font-size: clamp(38px, 5vw, 64px);
    }
    .hero-portrait {
      width: clamp(220px, 30vw, 340px);
    }
    .hero-bio {
      font-size: 15px;
    }
    .hero-main {
      max-width: 600px;
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: auto;
      padding-top: 75px;
      padding-bottom: 48px;
    }
    .hero-stage--desktop {
      display: block;
    }
    .hero-stage--mobile {
      display: none;
    }
    .hero-bottom {
      position: relative;
      margin-top: 340px;
      padding-left: var(--spacing-container-px);
      padding-right: var(--spacing-container-px);
      padding-bottom: 32px;
    }
    .hero-main {
      max-width: 100%;
    }
    .hero-title {
      margin-bottom: 16px;
      font-size: clamp(34px, 8.2vw, 46px);
    }
    .hero-bio {
      max-width: 100%;
      margin-bottom: 24px;
      font-size: 15px;
    }
    .hero-portrait {
      position: absolute;
      left: 50%;
      right: auto;
      top: 60px;
      bottom: auto;
      transform: translateX(-50%);
      width: clamp(230px, 62vw, 300px);
      height: clamp(250px, 48vh, 340px);
    }
    .hero-portrait-img {
      object-position: center top;
    }
    .hero-halo {
      left: 50%;
      top: 40%;
      transform: translate(-50%, -50%);
      width: 360px;
      height: 400px;
    }
    .hero-fade-bottom {
      height: 300px;
    }
    .hero-footer-bar {
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .hero-socials {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .hero-bottom {
      margin-top: 330px;
    }
  }
</style>

<script>
  const setupHeroBtn = () => {
    const btn = document.querySelector(".hero-cta") as HTMLElement;
    if (!btn) return;
    const arrow = btn.querySelector(".hero-arrow") as HTMLElement;
    const text = btn.querySelector(".hero-text") as HTMLElement;
    if (!arrow || !text) return;
    const padLeft = 8;
    const padRight = 24;
    const gap = 14;
    const txtShift = arrow.offsetWidth + gap - (padRight - padLeft);
    const arrShift = text.offsetWidth + gap + (padRight - padLeft);
    btn.style.setProperty("--arrShift", arrShift + "px");
    btn.style.setProperty("--txtShift", -txtShift + "px");
  };
  setupHeroBtn();
</script>
