---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ToolsMarquee from "../components/ToolsMarquee.astro";
import Services from "../components/Services.astro";
import LatestPosts from "../components/LatestPosts.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Matheus Costa - UX/UI Designer e Desenvolvedor Front-end"
  description="Web designer e desenvolvedor front-end em São José do Rio Preto/SP. Criação de sites profissionais, landing pages e e-commerces para pequenas empresas, clínicas, lojas e escritórios. Peça um orçamento no WhatsApp."
  keywords="criação de sites rio preto, web designer rio preto, site profissional são josé do rio preto, desenvolvimento de site rio preto, agência de web design rio preto, landing page profissional rio preto, site para pequenas empresas rio preto, criar site para clínica rio preto, criar site para loja rio preto, criar site para escritório rio preto, quanto custa um site rio preto"
>
  <main class="site-main">
    <Hero />
    <ToolsMarquee />
    <Services />
    <LatestPosts />
  </main>
  <Footer />
</Layout>

<style>
  .site-main {
    min-width: 320px;
    background: var(--color-bg-main);
    overflow: hidden;
  }
</style>
