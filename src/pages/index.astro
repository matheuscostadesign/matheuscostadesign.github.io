---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ToolsMarquee from "../components/ToolsMarquee.astro";
import Services from "../components/Services.astro";
import LatestPosts from "../components/LatestPosts.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Matheus Costa — UX/UI Designer e Desenvolvedor Front-end"
  description="UX/UI Designer e Desenvolvedor Front-end em São José do Rio Preto/SP. Sites, landing pages e e-commerces com estratégia, estética e clareza."
>
  <main class="site-main">
    <Hero />
    <ToolsMarquee />
    <Services />
    <LatestPosts />
  </main>
  <Footer />
</Layout>

<style>
  .site-main {
    min-width: 320px;
    background: var(--color-bg-main);
    overflow: hidden;
  }
</style>
