---
import Layout from "./Layout.astro";
import Footer from "../components/Footer.astro";
import SocialShare from "../components/blog/SocialShare.astro";
import AuthorBioCard from "../components/blog/AuthorBioCard.astro";
import SeoCalculator from "../components/blog/SeoCalculator.astro";
import NewsletterBox from "../components/blog/NewsletterBox.astro";
import RichMaterialCard from "../components/blog/RichMaterialCard.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const {
  title,
  description,
  author = "Matheus Costa",
  authorRole = "UX/UI Designer & Dev Front-end",
  authorAvatar = "/assets/matheus.webp",
  authorBio,
  categories,
  image,
  imageCaption,
  slug: customSlug,
  updatedDate,
} = post.data;

const slug =
  customSlug ||
  post.slug ||
  post.id
    .split("/")
    .pop()
    ?.replace(/\.mdx?$/, "");

const canonicalUrl = `https://matheuscostadesign.github.io/blog/${slug}`;

const meses = [
  "Janeiro",
  "Fevereiro",
  "Março",
  "Abril",
  "Maio",
  "Junho",
  "Julho",
  "Agosto",
  "Setembro",
  "Outubro",
  "Novembro",
  "Dezembro",
];

const match = post.id.match(/\d{4}-\d{2}-\d{2}/);
const date = match ? new Date(match[0]) : new Date();
const dia = date.getDate().toString().padStart(2, "0");
const mes = meses[date.getMonth()];
const ano = date.getFullYear();
const dateString = `${dia} de ${mes} de ${ano}`;

const rawBody = post.body || "";
const wordCount = rawBody.trim().split(/\s+/).filter(Boolean).length;
const readTimeMinutes = Math.max(1, Math.ceil(wordCount / 200));
---

<Layout
  title={`${title} - Blog Matheus Costa`}
  description={description}
  image={image}
>
  <div class="post-page">
    <main class="post-main">
      <article class="post-article">
        <nav aria-label="Breadcrumbs" class="breadcrumbs">
          <ol class="breadcrumb-list">
            <li class="breadcrumb-item">
              <a href="/">Home</a>
            </li>
            <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
            <li class="breadcrumb-item">
              <a href="/blog">Blog</a>
            </li>
            <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
            <li class="breadcrumb-item active" aria-current="page">
              {title}
            </li>
          </ol>
        </nav>

        <header class="post-header">
          <div class="post-meta-top">
            <span class="category-badge">{categories}</span>
            <div class="post-meta-pills">
              <span class="meta-pill date-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <time datetime={date.toISOString()}>{dateString}</time>
              </span>
              <span class="meta-pill readtime-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>{readTimeMinutes} min de leitura</span>
              </span>
            </div>
          </div>

          <h1 class="post-title">{title}</h1>

          {description && <p class="post-subtitle">{description}</p>}

          <div class="post-author-row">
            <img
              class="author-avatar"
              src={authorAvatar}
              alt={`Foto de ${author}`}
              width="48"
              height="48"
            />
            <div class="author-info">
              <span class="author-label">Escrito por</span>
              <span class="author-name">{author}</span>
              <span class="author-role">{authorRole}</span>
            </div>
          </div>
        </header>

        {
          image && (
            <figure class="post-cover-figure">
              <img class="post-cover" src={image} alt={title} />
              {imageCaption && <figcaption class="post-cover-caption">{imageCaption}</figcaption>}
            </figure>
          )
        }

        <SocialShare title={title} url={canonicalUrl} />

        <div class="post-body">
          <slot />
        </div>

        <SeoCalculator />

        <RichMaterialCard />

        <NewsletterBox />

        <AuthorBioCard
          author={author}
          authorRole={authorRole}
          authorAvatar={authorAvatar}
          authorBio={authorBio}
        />

        <div class="post-footer">
          <a href="/blog" class="back-btn">
            <span class="btn-arrow">
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="4" y1="12" x2="18.5" y2="12"></line>
                <polyline points="12.5 6 19 12 12.5 18"></polyline>
              </svg>
            </span>
            <span>Ver todos os artigos do Blog</span>
          </a>
        </div>
      </article>
    </main>

    <Footer />
  </div>

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description: description,
        image: image ? [image] : [],
        author: {
          "@type": "Person",
          name: author,
          jobTitle: authorRole,
          url: "https://matheuscostadesign.github.io",
        },
        publisher: {
          "@type": "Organization",
          name: "Matheus Costa",
          logo: {
            "@type": "ImageObject",
            url: "https://matheuscostadesign.github.io/assets/favicon/apple-icon-precomposed.png",
          },
        },
        datePublished: date.toISOString(),
        dateModified: updatedDate ? new Date(updatedDate).toISOString() : date.toISOString(),
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": canonicalUrl,
        },
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: "https://matheuscostadesign.github.io",
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "Blog",
            item: "https://matheuscostadesign.github.io/blog",
          },
          {
            "@type": "ListItem",
            position: 3,
            name: title,
            item: canonicalUrl,
          },
        ],
      },
    ])}
  />
</Layout>

<style>
  .post-page {
    min-height: 100vh;
    background: radial-gradient(
      120% 90% at 50% 0%,
      var(--color-bg-surface) 0%,
      var(--color-bg-main) 60%
    );
    color: var(--color-text-main);
  }

  .post-main {
    max-width: var(--container-max-width, 1200px);
    margin: 0 auto;
    padding: clamp(120px, 12vw, 160px) var(--spacing-container-px)
      var(--spacing-section-py);
  }

  .post-article {
    width: 100%;
  }

  .breadcrumbs {
    margin-bottom: 24px;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
    font-family: var(--font-body);
    font-size: 13.5px;
  }

  .breadcrumb-item a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb-item a:hover {
    color: var(--color-text-main);
  }

  .breadcrumb-item.active {
    color: var(--color-text-dimmed);
    font-weight: 500;
    max-width: 300px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .breadcrumb-separator {
    color: var(--color-text-dimmed);
  }

  .post-header {
    margin-bottom: 36px;
  }

  .post-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .category-badge {
    display: inline-block;
    padding: 4px 14px;
    border-radius: 9999px;
    background: rgba(244, 240, 231, 0.1);
    border: 1px solid var(--color-border-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    font-weight: 600;
    color: var(--color-text-main);
  }

  .post-meta-pills {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-text-dimmed);
  }

  .post-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: normal;
    line-height: 1.1;
    margin: 0 0 16px;
    color: var(--color-text-main);
  }

  .post-subtitle {
    font-family: var(--font-body);
    font-size: clamp(18px, 2.2vw, 22px);
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0 0 28px;
    font-weight: 400;
  }

  .post-author-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border-subtle);
  }

  .author-avatar {
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-border-subtle);
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .author-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-dimmed);
  }

  .author-name {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    color: var(--color-text-main);
  }

  .author-role {
    font-family: var(--font-body);
    font-size: 12.5px;
    color: var(--color-text-dimmed);
  }

  .post-cover-figure {
    width: 100%;
    margin: 0 0 40px;
  }

  .post-cover {
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    display: block;
    border-radius: 20px;
    border: 1px solid var(--color-border-subtle);
  }

  .post-cover-caption {
    font-family: var(--font-body);
    font-size: 13.5px;
    color: var(--color-text-dimmed);
    text-align: center;
    margin-top: 10px;
    font-style: italic;
  }

  .post-body {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  .post-body :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.2vw, 40px);
    font-weight: normal;
    line-height: 1.2;
    color: var(--color-text-main);
    margin: 52px 0 20px;
    border-left: 3px solid var(--color-text-main);
    padding-left: 16px;
  }

  .post-body :global(h3) {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.4vw, 28px);
    font-weight: normal;
    line-height: 1.25;
    color: var(--color-text-main);
    margin: 36px 0 16px;
  }

  .post-body :global(h4) {
    font-family: var(--font-display);
    font-size: clamp(18px, 2vw, 24px);
    font-weight: normal;
    color: var(--color-text-main);
    margin: 28px 0 12px;
  }

  .post-body :global(p) {
    margin: 0 0 28px;
  }

  .post-body :global(strong),
  .post-body :global(b) {
    color: var(--color-text-main);
    font-weight: 700;
  }

  .post-body :global(a) {
    color: var(--color-text-main);
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .post-body :global(a:hover) {
    opacity: 0.85;
  }

  .post-body :global(img) {
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: 16px;
    margin: 28px 0 8px;
    display: block;
    border: 1px solid var(--color-border-subtle);
  }

  .post-body :global(figure) {
    width: 100%;
    margin: 32px 0;
  }

  .post-body :global(figcaption) {
    font-family: var(--font-body);
    font-size: 13.5px;
    color: var(--color-text-dimmed);
    text-align: center;
    margin-top: 8px;
    font-style: italic;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 28px;
    padding-left: 28px;
    font-size: 18px;
    line-height: 1.75;
  }

  .post-body :global(li) {
    margin-bottom: 10px;
  }

  .post-body :global(blockquote) {
    border-left: 3px solid var(--color-border-hover);
    padding: 16px 24px;
    margin: 32px 0;
    background: var(--color-bg-card);
    border-radius: 0 12px 12px 0;
    font-style: italic;
    color: var(--color-text-main);
  }

  .post-body :global(code) {
    background: rgba(244, 240, 231, 0.1);
    padding: 3px 8px;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--color-text-main);
  }

  .post-body :global(pre) {
    background: var(--color-bg-card);
    padding: 24px;
    border-radius: 16px;
    overflow-x: auto;
    border: 1px solid var(--color-border-subtle);
    margin: 32px 0;
  }

  .post-body :global(pre code) {
    background: none;
    padding: 0;
  }

  .post-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 36px 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    background: var(--color-bg-card);
    font-size: 16px;
  }

  .post-body :global(th),
  .post-body :global(td) {
    padding: 14px 18px;
    text-align: left;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .post-body :global(th) {
    background: var(--color-bg-elevated);
    color: var(--color-text-main);
    font-family: var(--font-body);
    font-weight: 600;
  }

  .post-body :global(tr:last-child td) {
    border-bottom: none;
  }

  .post-body :global(iframe),
  .post-body :global(.video-container) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    border: 1px solid var(--color-border-subtle);
    margin: 36px 0;
  }

  .post-footer {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    justify-content: center;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: var(--color-text-main);
    color: var(--color-bg-main);
    border-radius: 9999px;
    padding: 10px 28px 10px 10px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--color-text-main);
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s,
      box-shadow 0.3s,
      transform 0.2s;
  }

  .back-btn:hover {
    background: var(--color-bg-elevated);
    color: var(--color-text-main);
    border-color: var(--color-border-hover);
    box-shadow: 0 0 24px rgba(0, 0, 0, 0.15);
    transform: translateY(-2px);
  }

  .back-btn .btn-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-bg-main);
    color: var(--color-text-main);
    flex-shrink: 0;
    transition:
      background 0.3s,
      color 0.3s,
      transform 0.3s;
  }

  .back-btn:hover .btn-arrow {
    background: var(--color-text-main);
    color: var(--color-bg-main);
    transform: rotate(45deg);
  }

  @media (max-width: 640px) {
    .post-main {
      padding-top: 100px;
    }
    .post-meta-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
</style>
